{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Open Quantum",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/examples"
